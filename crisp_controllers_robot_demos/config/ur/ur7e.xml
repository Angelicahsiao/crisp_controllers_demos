<mujoco model="ur7e">
  <!-- UR7e arm for crisp_mujoco_sim. Generated from Universal_Robots_ROS2_Description
       config/ur7e (default_kinematics.yaml, physical_parameters.yaml, joint_limits.yaml).

       Constraints imposed by crisp_mujoco_sim/Simulator:
       - joints/actuators are mapped to ros2_control BY INDEX, so the 6 arm joints
         must be the only joints in the model (nq == nv == nu == 6) and declared in
         controller order: shoulder_pan, shoulder_lift, elbow, wrist_1, wrist_2, wrist_3.
       - one <motor> per joint (torque control via d->ctrl).
       - a keyframe is required (the simulator copies key_qpos at startup).

       The Robotiq 2F-140 is a fixed mass on the flange: its ros2_control side runs on
       mock_components in fake mode, so simulating the finger joint here would corrupt
       the index mapping. Inertia tensors with a rotated URDF inertial frame
       (shoulder, wrist_1, wrist_2: ±90° about x) are pre-rotated into body frames. -->
  <compiler angle="radian"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="ur7e">
      <joint axis="0 0 1" damping="2.0" frictionloss="0.2"/>
    </default>
  </default>

  <worldbody>
    <body name="base_link">
      <inertial pos="0 0 0" mass="4.0" diaginertia="0.0061 0.0061 0.01125"/>
      <body name="shoulder_link" pos="0 0 0.1625">
        <joint name="shoulder_pan_joint" class="ur7e" range="-6.2832 6.2832" actuatorfrcrange="-150 150"/>
        <inertial pos="0 -0.00193 -0.02561" mass="3.761"
          fullinertia="0.00700210 0.00657286 0.00648091 0.00001053 0.00000073 -0.00049994"/>
        <body name="upper_arm_link" euler="1.570796327 0 0">
          <joint name="shoulder_lift_joint" class="ur7e" range="-6.2832 6.2832" actuatorfrcrange="-150 150"/>
          <inertial pos="-0.2125 0 0.11336" mass="8.058"
            fullinertia="0.01505885 0.33388086 0.33247207 -0.00005400 0.00000563 -0.00000181"/>
          <body name="forearm_link" pos="-0.425 0 0">
            <joint name="elbow_joint" class="ur7e" range="-3.1416 3.1416" actuatorfrcrange="-150 150"/>
            <inertial pos="-0.2422 0 0.0265" mass="2.846"
              fullinertia="0.00399632 0.07879254 0.07848510 -0.00001365 0.00137272 -0.00000660"/>
            <body name="wrist_1_link" pos="-0.3922 0 0.1333">
              <joint name="wrist_1_joint" class="ur7e" range="-6.2832 6.2832" actuatorfrcrange="-28 28"/>
              <inertial pos="0 -0.01634 -0.0018" mass="1.37"
                fullinertia="0.00165491 0.00126279 0.00135962 0.00000438 -0.00000282 -0.00010157"/>
              <body name="wrist_2_link" pos="0 -0.0997 0" euler="1.570796327 0 0">
                <joint name="wrist_2_joint" class="ur7e" range="-6.2832 6.2832" actuatorfrcrange="-28 28"/>
                <inertial pos="0 0.01634 -0.0018" mass="1.3"
                  fullinertia="0.00135617 0.00096614 0.00127827 0.00000444 0.00000274 0.00005048"/>
                <body name="wrist_3_link" pos="0 0.0996 0" euler="-1.570796327 0 0">
                  <joint name="wrist_3_joint" class="ur7e" range="-6.2832 6.2832" actuatorfrcrange="-28 28"/>
                  <inertial pos="0 0 -0.001159" mass="0.365"
                    fullinertia="0.00018694 0.00018908 0.00025756 0.00000006 -0.00000017 -0.00000092"/>
                  <!-- Robotiq 2F-140 + coupling as a rigid payload on the flange (tool axis = local +z). -->
                  <body name="robotiq_2f140" pos="0 0 0.06">
                    <inertial pos="0 0 0" mass="1.1" diaginertia="0.002 0.002 0.001"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_pan_motor"  joint="shoulder_pan_joint"  gear="1" ctrlrange="-150 150"/>
    <motor name="shoulder_lift_motor" joint="shoulder_lift_joint" gear="1" ctrlrange="-150 150"/>
    <motor name="elbow_motor"         joint="elbow_joint"         gear="1" ctrlrange="-150 150"/>
    <motor name="wrist_1_motor"       joint="wrist_1_joint"       gear="1" ctrlrange="-28 28"/>
    <motor name="wrist_2_motor"       joint="wrist_2_joint"       gear="1" ctrlrange="-28 28"/>
    <motor name="wrist_3_motor"       joint="wrist_3_joint"       gear="1" ctrlrange="-28 28"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 -1.5708 1.5708 -1.5708 -1.5708 0"/>
  </keyframe>
</mujoco>
