<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur">

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_140_macro.urdf.xacro"/>
  <xacro:include filename="$(find crisp_controllers_robot_demos)/config/ur/ur.ros2_control.urdf.xacro"/>

  <xacro:arg name="ur_type"             default="ur5e"/>
  <xacro:arg name="robot_ip"            default="192.168.56.101"/>
  <xacro:arg name="use_fake_hardware"   default="false"/>
  <xacro:arg name="tf_prefix"           default=""/>
  <!-- headless_mode=true bypasses URCapX ScriptBuilder entirely.
       The driver pushes external_control.urscript directly over port 30001.
       Required for torque control when URCapX ExternalControl < 1.2.0
       (older versions generate their own program loop that omits MODE_TORQUE).
       Prerequisite: pendant must be in Remote Control mode. -->
  <xacro:arg name="headless_mode"       default="true"/>

  <!-- Robotiq 2F-140 serial port. USB-to-RS485 adapter on the host. -->
  <xacro:arg name="com_port"            default="/dev/ttyUSB0"/>

  <xacro:arg name="kinematics_parameters_file"
    default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>

  <xacro:property name="ur_type_val"   value="${xacro.arg('ur_type')}"/>
  <xacro:property name="tf_prefix_val" value="${xacro.arg('tf_prefix')}"/>

  <link name="world"/>

  <!-- ur_description's ur_robot macro differs by distro:
       - Humble: also emits a <ros2_control> block. We suppress it with
         generate_ros2_control_tag="false" because that block does not honour
         script_filename/recipe params (it emits a to_be_filled_by_ur_robot_driver
         placeholder); the custom ur_arm_ros2_control macro below embeds the real paths.
       - Jazzy+: the macro is kinematic-only and has no generate_ros2_control_tag
         parameter, so passing it raises 'Invalid parameter generate_ros2_control_tag'.
       Branch on ROS_DISTRO so the same file works on both. -->
  <xacro:arg name="ros_distro" default="$(env ROS_DISTRO)"/>
  <xacro:if value="${xacro.arg('ros_distro') == 'humble'}">
    <xacro:ur_robot
      name="${ur_type_val}"
      tf_prefix="${tf_prefix_val}"
      parent="world"
      joint_limits_parameters_file="$(find ur_description)/config/${ur_type_val}/joint_limits.yaml"
      kinematics_parameters_file="$(arg kinematics_parameters_file)"
      physical_parameters_file="$(find ur_description)/config/${ur_type_val}/physical_parameters.yaml"
      visual_parameters_file="$(find ur_description)/config/${ur_type_val}/visual_parameters.yaml"
      generate_ros2_control_tag="false">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:ur_robot>
  </xacro:if>
  <xacro:unless value="${xacro.arg('ros_distro') == 'humble'}">
    <xacro:ur_robot
      name="${ur_type_val}"
      tf_prefix="${tf_prefix_val}"
      parent="world"
      joint_limits_parameters_file="$(find ur_description)/config/${ur_type_val}/joint_limits.yaml"
      kinematics_parameters_file="$(arg kinematics_parameters_file)"
      physical_parameters_file="$(find ur_description)/config/${ur_type_val}/physical_parameters.yaml"
      visual_parameters_file="$(find ur_description)/config/${ur_type_val}/visual_parameters.yaml">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:ur_robot>
  </xacro:unless>

  <xacro:ur_arm_ros2_control
    name="${ur_type_val}"
    robot_ip="$(arg robot_ip)"
    use_fake_hardware="$(arg use_fake_hardware)"
    tf_prefix="${tf_prefix_val}"
    headless_mode="$(arg headless_mode)"
    kinematics_parameters_file="$(arg kinematics_parameters_file)"/>

  <xacro:robotiq_gripper
    name="RobotiqGripperHardwareInterface"
    prefix="${tf_prefix_val}"
    parent="tool0"
    use_fake_hardware="$(arg use_fake_hardware)"
    com_port="$(arg com_port)"
    include_ros2_control="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

  <!-- Measured payload correction. The robotiq_description URDF models only
       ~0.364 kg of the 2F-140, but the true gripper + coupling + fingers was
       measured at 1.3096 kg with COM in tool0 = (-0.0021, -0.0031, 0.0579) m
       using `ros2 run crisp_controllers_robot_demos identify_payload` (wrist F/T
       least-squares fit). Add the DIFFERENCE as a lumped mass at the measured
       COM so the Pinocchio gravity model g(q) - used by external_effort
       estimation AND any model-based controller reading /robot_description -
       reflects the real payload. Only mass and COM affect gravity torque; the
       inertia tensor is a compact placeholder. Re-run identify_payload and update
       these args if the tool changes. (Placing the supplement at the measured COM
       assumes the robotiq model's COM ~ the true COM, which holds because the
       gripper geometry is modeled even though its mass magnitude was too low.) -->
  <xacro:arg name="gripper_total_mass" default="1.3096"/>
  <xacro:arg name="gripper_com_x"      default="-0.0021"/>
  <xacro:arg name="gripper_com_y"      default="-0.0031"/>
  <xacro:arg name="gripper_com_z"      default="0.0579"/>

  <link name="${tf_prefix_val}gripper_payload_correction">
    <inertial>
      <origin xyz="$(arg gripper_com_x) $(arg gripper_com_y) $(arg gripper_com_z)" rpy="0 0 0"/>
      <!-- supplement = measured total - the ~0.364 kg the robotiq URDF already models -->
      <mass value="${$(arg gripper_total_mass) - 0.364}"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="${tf_prefix_val}gripper_payload_correction_joint" type="fixed">
    <parent link="tool0"/>
    <child  link="${tf_prefix_val}gripper_payload_correction"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
